{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uip-react",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "vars": {
    "API_ORIGIN": "https://uip-laravel-production.up.railway.app"
  },
  "previews": {
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issue_detection": {
        "enabled": true
      }
    }
  }
}
